            finalizeInput(epochId, 2, 2, 2, FINALIZED_AGGREGATE_COMMITMENTS_HASH, FINALIZED_COLLECTIVE_PUBLIC_KEY_HASH, FINALIZED_SHARE_COMMITMENT_HASH)
        );
    }
