import {Test, Vm} from "forge-std/Test.sol";
import {DKGRegistry} from "../src/DKGRegistry.sol";
import {DKGManager} from "../src/DKGManager.sol";
import {DKGAppManager} from "../src/DKGAppManager.sol";
import {IDKGManager} from "../src/interfaces/IDKGManager.sol";
import {IDKGAppManager} from "../src/interfaces/IDKGAppManager.sol";
import {DKGTypes} from "../src/libraries/DKGTypes.sol";
import {BRLC} from "../src/libraries/BRLC.sol";
import {MAX_N, MAX_K, MERKLE_DEPTH, FINALIZE_KEY_WORDS_STRIDE} from "../src/libraries/Sizes.sol";
import {BabyJubJub} from "../src/libraries/BabyJubJub.sol";
import {
    MockContributionVerifier,
    MockPartialDecryptVerifier,
    MockDecryptCombineVerifier,
    TestHelpers
} from "./TestHelpers.t.sol";
import {MockVerifier} from "./MockVerifier.sol";

contract DKGManagerTest is Test, TestHelpers {
    DKGRegistry public registry;
    MockContributionVerifier public verifier;
    MockPartialDecryptVerifier public partialVerifier;
    MockVerifier public finalizeVerifier;
    MockDecryptCombineVerifier public decryptCombineVerifier;
    DKGManager public manager;
    DKGAppManager public appManager;

    uint64 internal constant INACTIVITY_WINDOW = 1_000;

    /// @dev Committee member 1 of every fixture epoch. Must be a plain
    ///      address with no code: submitContribution / finalizeEpoch
    ///      reject contract callers (DirectCallRequired), and the test
    ///      contract itself is a contract, so it can never contribute.
    address internal alice = address(0xA11CE);

    /// @dev Every ciphertext in this suite lives under one registered
    ///      application: there is no epoch-key (aid = 0) path any more.
    bytes32 internal constant TEST_AID = bytes32(uint256(0xA1D));

    // Schnorr vectors generated by cmd/operator-schnorr-vectors. ALICE is
    // 0xA11CE (committee slot 0); BEEF is 0xBEEF (committee slot 1). Both
    // are codeless addresses, see `alice` above.
    uint256 internal constant ALICE_PUBX =
        14666979294172776374634275498241310759674509575452256743546893482427808967539;
    uint256 internal constant ALICE_PUBY =
        16568773859060023308888034681483224034881825787861296311803627274237556869649;
    uint256 internal constant ALICE_AX =
        206825796546323573150801242605652465781823711295602898923500400375891572685;
    uint256 internal constant ALICE_AY =
        14223109950820609858208501628131627333362274908883166606890781114024603385194;
    uint256 internal constant ALICE_Z =
        1415349030302839010594375480381656799266590814245522079555192493283473059241;
    uint256 internal constant BEEF_PUBX =
        10228722604559478181013548940833210623190136968531440936190496170400150013980;
    uint256 internal constant BEEF_PUBY =
        13886497050333420293068628977630539070604271411621054562122682889313139677221;
    uint256 internal constant BEEF_AX =
        14566234973743316386655481200503006158732416518867749191804063760238069794878;
    uint256 internal constant BEEF_AY =
        13078057343376780948266496972118389875598288245980415388506507934563371992806;
    uint256 internal constant BEEF_Z =
        855437853746059451716869189734643730464853812739723681978635195783451059776;

    function setUp() public {
        registry = new DKGRegistry(INACTIVITY_WINDOW);
        vm.prank(alice);
        registry.registerKey(ALICE_PUBX, ALICE_PUBY, ALICE_AX, ALICE_AY, ALICE_Z);
        vm.prank(address(0xBEEF));
        registry.registerKey(BEEF_PUBX, BEEF_PUBY, BEEF_AX, BEEF_AY, BEEF_Z);
        verifier = new MockContributionVerifier();
        partialVerifier = new MockPartialDecryptVerifier();
        finalizeVerifier = new MockVerifier();
        decryptCombineVerifier = new MockDecryptCombineVerifier();
        manager = new DKGManager(
            31337,
            address(registry),
            address(verifier),
            address(partialVerifier),
            address(finalizeVerifier),
            address(decryptCombineVerifier),
            0,  // epochDurationBlocks → DEFAULT (100)
            0,  // committeeSelectionBlocks → DEFAULT (25)
            0,  // keyAssemblyBlocks → DEFAULT (25)
            0,  // finalizeGapBlocks → DEFAULT (5)
            0, 0, 0 // policy floors → permissive defaults
        );
        // Wire the liveness callback so submitContribution can refresh
        // the contributor's lastActiveBlock on the registry.
        registry.setManager(address(manager));
        appManager = new DKGAppManager(address(manager));
        manager.setAppManager(address(appManager));
        // Operators only enter lotteries of epochs created after they registered.
        vm.roll(block.number + 1);
    }

    // ─── Lifecycle helpers ────────────────────────────────────────────────────

    function createSelectedRound() internal returns (bytes12 epochId) {
        epochId = _createLotteryRound();
        _claimAllSlots(epochId);
    }

    /// @dev Creates a epoch with a lottery threshold of "everyone passes" so the two
    /// registered test nodes (address(this) and 0xBEEF) are both eligible.
    /// All phase deadlines are derived from the contract's
    /// `EPOCH_DURATION_BLOCKS` (100 in the default-deploy test fixture).
    function _createLotteryRound() internal returns (bytes12 epochId) {
        // Permissionless cadence: roll forward to nextEpochStartBlock if
        // a previous epoch was just created in this same test.
        uint64 next = manager.nextEpochStartBlock();
        if (block.number < uint256(next)) vm.roll(uint256(next));
        // α = 1.0 (10000 bps), committeeSize = 2, registered = 2 → all pass.
        epochId = manager.createEpoch(2, 2, 2, 10000);
        // Advance past seedBlock so blockhash is available.
        vm.roll(block.number + 2);
    }

    function _claimAllSlots(bytes12 epochId) internal {
        vm.prank(alice);
        manager.claimSlot(epochId);
        vm.prank(address(0xBEEF));
        manager.claimSlot(epochId);
    }

    /// @dev Advance to a block at or after `liveNotBeforeBlock` for the epoch.
    function _advanceToFinalize(bytes12 epochId) internal {
        IDKGManager.Epoch memory r = manager.getEpoch(epochId);
        if (block.number < uint256(r.policy.liveNotBeforeBlock)) {
            vm.roll(uint256(r.policy.liveNotBeforeBlock));
        }
    }

    /// @dev Contributions must come from a direct EOA call: prank with
    ///      matching msg.sender/tx.origin (a single-arg prank leaves
    ///      tx.origin untouched and trips DirectCallRequired).
    function _submitContribution(bytes12 epochId, uint16 idx) internal {
        address who = idx == 2 ? address(0xBEEF) : alice;
        vm.prank(who, who);
        manager.submitContribution(
            epochId,
            idx,
            contributorCommitmentsHash(idx),
            contributorSharesHash(idx),
            contributionTranscript(2, 2),
            contributionProof(),
            contributionInput(epochId, 2, 2, idx, contributorCommitmentsHash(idx), contributorSharesHash(idx))
        );
    }

    function _submitBothContributions(bytes12 epochId) internal {
        _submitContribution(epochId, 1);
        _submitContribution(epochId, 2);
    }

    /// @dev `finalizeEpoch` of a committee-of-two epoch with `threshold` t and
    ///      `acceptedCount` accepted contributors. Permissionless, but still a
    ///      direct EOA call (see _submitContribution).
    function _finalize(bytes12 epochId, uint16 threshold, uint16 acceptedCount) internal {
        vm.prank(alice, alice);
        manager.finalizeEpoch(
            epochId,
            testFinalizeDigest(),
            finalizeTranscript(acceptedCount, 2),
            finalizeProof(),
            finalizeInput(epochId, threshold, 2, acceptedCount)
        );
    }

    /// @dev `finalizeEpoch` over an explicit (possibly tampered) word vector
    ///      with a consistent challenge and BRLC commitment.
    function _finalizeWithWords(bytes12 epochId, uint16 threshold, uint16 acceptedCount, uint256[] memory words)
        internal
    {
        bytes memory input = finalizeInputForWords(epochId, threshold, 2, acceptedCount, words);
        vm.prank(alice, alice);
        manager.finalizeEpoch(epochId, testFinalizeDigest(), abi.encodePacked(words), finalizeProof(), input);
    }

    /// @dev Same, with an explicit public-input vector.
    function _finalizeWithInput(bytes12 epochId, bytes memory input) internal {
        vm.prank(alice, alice);
        manager.finalizeEpoch(
            epochId, testFinalizeDigest(), finalizeTranscript(2, 2), finalizeProof(), input
        );
    }

    /// @dev An epoch driven all the way to Live: finalize proves and stores
    ///      the whole MAX_K-key pool in one shot.
    function createLiveRound() internal returns (bytes12 epochId) {
        epochId = createSelectedRound();
        _submitBothContributions(epochId);
        _advanceToFinalize(epochId);
        _finalize(epochId, 2, 2);
    }

    /// @dev The canonical fixture: Live epoch (whole pool proven and stored),
    ///      key 0 claimed by `TEST_AID` (an `OrganizerLocked` application
    ///      whose secret is already revealed, so partials and combines are
    ///      open), one ciphertext submitted at index 1.
    function createFinalizedRound() internal returns (bytes12 epochId) {
        epochId = createLiveRound();
        _registerTestApp(epochId, TEST_AID);
        appManager.revealOrganizerSecret(epochId, TEST_AID, TEST_ORG_SK);
        _submitTestCiphertext(epochId, TEST_AID);
    }

    /// @dev Register `aid` under the canonical test organizer key, with an
    ///      all-zero policy (which resolves the authorized submitter to the
    ///      caller — address(this) unless pranked).
    function _registerTestApp(bytes12 epochId, bytes32 aid) internal {
        (uint256 pkx, uint256 pky, uint256 ax, uint256 ay, uint256 z) = organizerPoP(epochId, aid);
        appManager.registerApplication(epochId, aid, _emptyAppPolicy(), pkx, pky, ax, ay, z);
    }

    function _emptyAppPolicy() internal pure returns (DKGTypes.AppPolicy memory) {
        return DKGTypes.AppPolicy({
            mode: DKGTypes.AppMode.OrganizerLocked,
            openSubmission: false,
            submitters: new address[](0),
            maxCiphertexts: 0,
            notBeforeBlock: 0,
            notAfterBlock: 0,
            decryptNotBefore: 0,
            decryptNotAfter: 0
        });
    }

    function _submitTestCiphertext(bytes12 epochId, bytes32 aid) internal returns (uint16) {
        return manager.submitCiphertext(epochId, aid, TEST_CT_C1X, TEST_CT_C1Y, TEST_CT_C2X, TEST_CT_C2Y);
    }

    function _submitPartial(bytes12 epochId, bytes32 aid, uint16 pIdx, uint16 ctIdx) internal {
        uint8 keyIndex = manager.getAppPoolIndex(epochId, aid);
        vm.prank(pIdx == 2 ? address(0xBEEF) : alice);
        manager.submitPartialDecryption(
            epochId, aid, pIdx, ctIdx,
            TEST_CT_C1X, TEST_CT_C1Y, TEST_CT_C2X, TEST_CT_C2Y,
            partialDecryptionHash(pIdx),
            partialDecryptionProof(),
            partialDecryptionInput(epochId, aid, pIdx, ctIdx, keyIndex),
            shareProofFor(keyIndex, 2, pIdx)
        );
    }

    /// @dev Both committee members post their partial decryption of
    ///      `ciphertextIndex` under `aid`.
    function _submitBothPartials(bytes12 epochId, bytes32 aid, uint16 ctIdx) internal {
        _submitPartial(epochId, aid, 1, ctIdx);
        _submitPartial(epochId, aid, 2, ctIdx);
    }

    // ─── Epoch creation and lottery ───────────────────────────────────────────

    function test_CreateEpoch_PersistsPolicy() public {
        // committeeSize=2, registered=2, α=1.0 → all eligible
        bytes12 epochId = manager.createEpoch(2, 2, 2, 10000);

        IDKGManager.Epoch memory epoch = manager.getEpoch(epochId);

        assertEq(epoch.organizer, address(this));
        assertEq(uint256(epoch.policy.threshold), 2);
        assertEq(uint256(epoch.policy.committeeSize), 2);
        assertEq(uint256(epoch.status), uint256(DKGTypes.EpochPhase.CommitteeSelection));
    }

    function test_ClaimSlot_RejectsBeforeSeedReady() public {
        bytes12 epochId = manager.createEpoch(2, 2, 2, 10000);
        // Don't roll forward — seed block has not been mined yet.
        vm.expectRevert(IDKGManager.SeedNotReady.selector);
        manager.claimSlot(epochId);
    }

    function test_ClaimSlot_RejectsDuplicates() public {
        bytes12 epochId = _createLotteryRound();
        vm.prank(alice);
        manager.claimSlot(epochId);
        vm.expectRevert(IDKGManager.AlreadyClaimed.selector);
        vm.prank(alice);
        manager.claimSlot(epochId);
    }

    function test_ClaimSlot_FillsCommitteeAndAdvancesPhase() public {
        bytes12 epochId = _createLotteryRound();
        _claimAllSlots(epochId);

        IDKGManager.Epoch memory epoch = manager.getEpoch(epochId);
        address[] memory selected = manager.selectedParticipants(epochId);

        assertEq(uint256(epoch.status), uint256(DKGTypes.EpochPhase.KeyAssembly));
        assertEq(selected.length, 2);
        assertEq(selected[0], alice);
        assertEq(selected[1], address(0xBEEF));
    }

    /// @dev Filling the committee publishes the members' keys in the
    ///      CommitteeSnapshot event: nodes build contribution witnesses
    ///      from that frozen view instead of the live registry, so a later
    ///      updateKey rotation cannot desync an honest contributor from the
    ///      on-chain prefix hash.
    function test_ClaimSlot_EmitsCommitteeSnapshot() public {
        vm.recordLogs();
        bytes12 epochId = createSelectedRound();

        bytes32 topic = keccak256("CommitteeSnapshot(bytes12,uint16,uint256[])");
        Vm.Log[] memory logs = vm.getRecordedLogs();
        bool found;
        for (uint256 i = 0; i < logs.length; i++) {
            if (logs[i].topics.length != 2 || logs[i].topics[0] != topic) continue;
            assertEq(logs[i].emitter, address(manager));
            assertEq(uint256(bytes32(bytes12(epochId))), uint256(logs[i].topics[1]));
            (uint16 committeeSize, uint256[] memory pubKeys) = abi.decode(logs[i].data, (uint16, uint256[]));
            assertEq(uint256(committeeSize), 2);
            assertEq(pubKeys.length, 4);
            assertEq(pubKeys[0], ALICE_PUBX);
            assertEq(pubKeys[1], ALICE_PUBY);
            assertEq(pubKeys[2], BEEF_PUBX);
            assertEq(pubKeys[3], BEEF_PUBY);
            found = true;
        }
        assertTrue(found);
    }

    function test_ClaimSlot_RejectsAfterSlotsFull() public {
        bytes12 epochId = _createLotteryRound();
        _claimAllSlots(epochId);
        // epoch.status is now KeyAssembly, so further claimSlot calls should revert
        // on phase, not on slots-full (we never reach the slots-full check).
        vm.prank(address(0xCAFE));
        vm.expectRevert(IDKGManager.InvalidPhase.selector);
        manager.claimSlot(epochId);
    }

    function test_GetContributionVerifierVKeyHash() public view {
        assertEq(uint256(manager.getContributionVerifierVKeyHash()), uint256(CONTRIBUTION_PROVING_KEY_HASH));
    }

    function test_GetPartialDecryptVerifierVKeyHash() public view {
        assertEq(uint256(manager.getPartialDecryptVerifierVKeyHash()), uint256(PARTIAL_DECRYPTION_PROVING_KEY_HASH));
    }

    function test_GetFinalizeVerifierVKeyHash() public view {
        assertEq(uint256(manager.getFinalizeVerifierVKeyHash()), uint256(finalizeVerifier.PROVING_KEY_HASH()));
    }

    // ─── Contribution ─────────────────────────────────────────────────────────

    /// @dev The record now stores the Poseidon `commitmentsHash` (public input
    ///      4), which is exactly what `finalizeEpoch` re-checks per row.
    function test_SubmitContribution_PersistsRecord() public {
        bytes12 epochId = createSelectedRound();
        _submitContribution(epochId, 1);

        DKGTypes.ContributionRecord memory record = manager.getContribution(epochId, alice);
        IDKGManager.Epoch memory epoch = manager.getEpoch(epochId);

        assertEq(uint256(record.contributorIndex), 1);
        assertEq(uint256(record.commitmentsHash), uint256(CONTRIBUTION_COMMITMENTS_HASH));
        assertTrue(record.accepted);
        assertEq(uint256(epoch.contributionCount), 1);
    }

    function test_SubmitContribution_RejectsUnselectedOperator() public {
        bytes12 epochId = createSelectedRound();

        vm.prank(address(0xCAFE), address(0xCAFE));
        vm.expectRevert(IDKGManager.NotSelectedParticipant.selector);
        manager.submitContribution(
            epochId, 1, contributorCommitmentsHash(1), contributorSharesHash(1),
            contributionTranscript(2, 2), contributionProof(),
            contributionInput(epochId, 2, 2, 1, contributorCommitmentsHash(1), contributorSharesHash(1))
        );
    }

    function test_SubmitContribution_RejectsDuplicates() public {
        bytes12 epochId = createSelectedRound();
        _submitContribution(epochId, 1);

        vm.expectRevert(IDKGManager.AlreadyContributed.selector);
        vm.prank(alice, alice);
        manager.submitContribution(
            epochId, 1, contributorCommitmentsHash(1), contributorSharesHash(1),
            contributionTranscript(2, 2), contributionProof(),
            contributionInput(epochId, 2, 2, 1, contributorCommitmentsHash(1), contributorSharesHash(1))
        );
    }

    function test_SubmitContribution_RejectsBadProofInput() public {
        bytes12 epochId = createSelectedRound();

        // The manager validates cheap public-input bindings before invoking
        // the verifier, so a tampered input vector reverts with the manager's
        // own InvalidProofInput rather than the verifier's.
        vm.expectRevert(IDKGManager.InvalidProofInput.selector);
        vm.prank(alice, alice);
        manager.submitContribution(
            epochId, 1, contributorCommitmentsHash(1), contributorSharesHash(1),
            contributionTranscript(2, 2), contributionProof(),
            CONTRIBUTION_INPUT_BAD
        );
    }

    /// @dev The committee section of the transcript lives at
    ///      `[2Kt, 2Kt+3n)`; a transcript whose committee prefix does not match
    ///      the lottery snapshot is rejected regardless of the proof. The
    ///      challenge and BRLC commitment are recomputed over the altered
    ///      words so the call gets past Fiat–Shamir and the mock verifier and
    ///      it is the prefix check that rejects.
    function test_SubmitContribution_RejectsWrongCommitteePrefix() public {
        bytes12 epochId = createSelectedRound();
        uint256[] memory words = contributionWords(2, 2);
        words[2 * MAX_K * 2] = 7; // recipientIndexes[0] should be 1
        bytes memory input = contributionInputForWords(
            epochId, 2, 2, 1, contributorCommitmentsHash(1), contributorSharesHash(1), words
        );
        vm.expectRevert(IDKGManager.InvalidProofInput.selector);
        vm.prank(alice, alice);
        manager.submitContribution(
            epochId, 1, contributorCommitmentsHash(1), contributorSharesHash(1),
            abi.encodePacked(words), contributionProof(), input
        );
        // The same envelope with the honest prefix lands: nothing else was off.
        _submitContribution(epochId, 1);
        assertTrue(manager.getContribution(epochId, alice).accepted);
    }

    /// @dev A transcript word at or above the scalar-field modulus commits
    ///      exactly like its reduction, so the contract must refuse it rather
    ///      than store the raw value. Here a masked share carries `v + p`.
    function test_SubmitContribution_RejectsNonCanonicalWord() public {
        bytes12 epochId = createSelectedRound();
        uint256[] memory words = contributionWords(2, 2);
        uint256 msBase = 2 * MAX_K * 2 + 5 * 2;
        words[msBase] = words[msBase] + FR_MOD;
        bytes memory input = contributionInputForWords(
            epochId, 2, 2, 1, contributorCommitmentsHash(1), contributorSharesHash(1), words
        );
        vm.expectRevert(BRLC.TranscriptWordNotInField.selector);
        vm.prank(alice, alice);
        manager.submitContribution(
            epochId, 1, contributorCommitmentsHash(1), contributorSharesHash(1),
            abi.encodePacked(words), contributionProof(), input
        );
    }

    function test_SubmitContribution_RefreshesLastActiveBlock() public {
        bytes12 epochId = createSelectedRound();

        uint64 before = registry.getNode(alice).lastActiveBlock;
        vm.roll(block.number + 10);
        _submitContribution(epochId, 1);

        uint64 afterBlock = registry.getNode(alice).lastActiveBlock;
        assertEq(uint256(afterBlock), block.number);
        assertTrue(afterBlock > before);
    }

    // ─── Direct EOA-call gate ────────────────────────────────────────────────

    /// @dev A contract-relayed submitContribution reverts before any other
    ///      check: nodes and the SDK rebuild contributions from the outer
    ///      transaction calldata, which an internal call never carries. The
    ///      nonsense epoch and empty proof bytes prove the ordering — only
    ///      the caller is wrong.
    function test_SubmitContribution_RejectsContractCaller() public {
        DirectCallForwarder forwarder = new DirectCallForwarder();
        vm.expectRevert(IDKGManager.DirectCallRequired.selector);
        forwarder.submit(
            address(manager),
            bytes12(uint96(0xDEAD)),
            1,
            bytes32(0),
            bytes32(0),
            "",
            "",
            ""
        );
    }

    /// @dev Same gate on finalizeEpoch, over a fully valid finalize
    ///      envelope: only the caller is wrong.
    function test_FinalizeEpoch_RejectsContractCaller() public {
        bytes12 epochId = createSelectedRound();
        _submitBothContributions(epochId);
        _advanceToFinalize(epochId);
        DirectCallForwarder forwarder = new DirectCallForwarder();
        vm.expectRevert(IDKGManager.DirectCallRequired.selector);
        forwarder.finalize(
            address(manager),
            epochId,
            testFinalizeDigest(),
            finalizeTranscript(2, 2),
            finalizeProof(),
            finalizeInput(epochId, 2, 2, 2)
        );
    }

    // ─── finalizeEpoch (proof-carrying, whole pool at once) ─────────────────

    /// @dev One finalize call flips the epoch Live and stores every key and
    ///      every share root of the pool; the roots are recomputed
    ///      independently by the test from the synthetic transcript.
    function test_FinalizeEpoch_SetsLiveAndStoresWholePool() public {
        bytes12 epochId = createSelectedRound();
        _submitBothContributions(epochId);
        _advanceToFinalize(epochId);
        _finalize(epochId, 2, 2);

        IDKGManager.Epoch memory epoch = manager.getEpoch(epochId);
        assertEq(uint256(epoch.status), uint256(DKGTypes.EpochPhase.Live));
        assertEq(uint256(epoch.contributionCount), 2);
        // Nothing claimed yet.
        assertEq(uint256(manager.getPoolStatus(epochId)), 0);

        for (uint8 j = 0; j < uint8(MAX_K); j++) {
            (uint256 x, uint256 y) = manager.getPoolKey(epochId, j);
            (uint256 ex, uint256 ey) = testPoolKey(j);
            assertEq(x, ex);
            assertEq(y, ey);
            assertEq(uint256(manager.getPoolShareRoot(epochId, j)), uint256(expectedShareRoot(j, 2)));
        }
        // Distinct keys must produce distinct roots, or a partial decryption
        // for one application would verify against another's.
        assertTrue(manager.getPoolShareRoot(epochId, 0) != manager.getPoolShareRoot(epochId, 1));
    }

    /// @dev A t = 1 epoch with a single accepted contributor finalizes over
    ///      one row; the whole committee's share slots still get leaves.
    function test_FinalizeEpoch_SingleContribution() public {
        uint64 next = manager.nextEpochStartBlock();
        if (block.number < uint256(next)) vm.roll(uint256(next));
        bytes12 epochId = manager.createEpoch(1, 2, 1, 10000);
        vm.roll(block.number + 2);
        _claimAllSlots(epochId);
        vm.prank(alice, alice);
        manager.submitContribution(
            epochId, 1, contributorCommitmentsHash(1), contributorSharesHash(1),
            contributionTranscript(1, 2), contributionProof(),
            contributionInput(epochId, 1, 2, 1, contributorCommitmentsHash(1), contributorSharesHash(1))
        );
        _advanceToFinalize(epochId);

        _finalize(epochId, 1, 1);

        assertEq(uint256(manager.getEpoch(epochId).status), uint256(DKGTypes.EpochPhase.Live));
        assertEq(uint256(manager.getPoolShareRoot(epochId, 0)), uint256(expectedShareRoot(0, 2)));
    }

    function test_FinalizeEpoch_RejectsTwice() public {
        bytes12 epochId = createLiveRound();
        vm.expectRevert(IDKGManager.AlreadyLive.selector);
        _finalize(epochId, 2, 2);
    }

    function test_FinalizeEpoch_RejectsInsufficientContributions() public {
        bytes12 epochId = createSelectedRound();
        _submitContribution(epochId, 1);
        _advanceToFinalize(epochId);

        vm.expectRevert(IDKGManager.InsufficientContributions.selector);
        _finalize(epochId, 2, 2);
    }

    function test_FinalizeEpoch_RejectsBeforeFinalizeNotBeforeBlock() public {
        bytes12 epochId = createSelectedRound();
        _submitBothContributions(epochId);

        // Both contributions in, threshold met — but liveNotBeforeBlock
        // not yet reached. Must revert with InvalidPhase (the gate reuses this
        // selector to keep the contract under the EIP-170 size limit).
        IDKGManager.Epoch memory r = manager.getEpoch(epochId);
        assertTrue(block.number < uint256(r.policy.liveNotBeforeBlock));

        vm.expectRevert(IDKGManager.InvalidPhase.selector);
        _finalize(epochId, 2, 2);

        // Roll exactly to liveNotBeforeBlock — should succeed.
        vm.roll(uint256(r.policy.liveNotBeforeBlock));
        _finalize(epochId, 2, 2);
