{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens for Voltagent-Inspired",
  "meta": {
    "name": "Voltagent-Inspired",
    "description": "An inspired interpretation of Voltagent's design language — a developer-focused AI agent engineering platform whose surface is an unrelenting near-black canvas broken only by a single electric-green brand accent, code-editor mockups inside the hero, and a precise grid of dark feature cards that read like a documentation site dressed as marketing.",
    "theme": "dark"
  },
  "color": {
    "primary": {
      "$value": "#00d992",
      "$type": "color",
      "$description": "Use for the primary role."
    },
    "primary-soft": {
      "$value": "#2fd6a1",
      "$type": "color",
      "$description": "Use for the primary soft role."
    },
    "primary-deep": {
      "$value": "#10b981",
      "$type": "color",
      "$description": "Use for the primary deep role."
    },
    "on-primary": {
      "$value": "#101010",
      "$type": "color",
      "$description": "Use for the on primary role."
    },
    "ink": {
      "$value": "#f2f2f2",
      "$type": "color",
      "$description": "Use for the ink role."
    },
    "ink-strong": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Use for the ink strong role."
    },
    "body": {
      "$value": "#bdbdbd",
      "$type": "color",
      "$description": "Use for the body role."
    },
    "mute": {
      "$value": "#8b949e",
      "$type": "color",
      "$description": "Use for the mute role."
    },
    "hairline": {
      "$value": "#3d3a39",
      "$type": "color",
      "$description": "Use for the hairline role."
    },
    "hairline-soft": {
      "$value": "#b8b3b0",
      "$type": "color",
      "$description": "Use for the hairline soft role."
    },
    "canvas": {
      "$value": "#101010",
      "$type": "color",
      "$description": "Use for the canvas role."
    },
    "canvas-soft": {
      "$value": "#1a1a1a",
      "$type": "color",
      "$description": "Use for the canvas soft role."
    },
    "canvas-text-soft": {
      "$value": "#f5f6f7",
      "$type": "color",
      "$description": "Use for the canvas text soft role."
    }
  },
  "typography": {
    "display-xl": {
      "$value": {
        "fontFamily": "Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
        "fontSize": "60px",
        "fontWeight": 400,
        "lineHeight": "60px",
        "letterSpacing": "-0.65px"
      },
      "$type": "typography",
      "$description": "Typography style for display xl."
    },
    "display-lg": {
      "$value": {
        "fontFamily": "Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
        "fontSize": "36px",
        "fontWeight": 400,
        "lineHeight": "40px",
        "letterSpacing": "-0.9px"
      },
      "$type": "typography",
      "$description": "Typography style for display lg."
    },
    "display-md": {
