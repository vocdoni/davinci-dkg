# ---------------------------------------------------------------------------
# davinci-dkg-node configuration
#
# Copy to .env and set DAVINCI_DKG_PRIVKEY: that is all a node on the
# Gnosis Chain deployment needs. Every entry is also settable as a CLI
# flag — run `davinci-dkg-node --help` for the full list.
# Env vars use the DAVINCI_DKG_ prefix and dots/dashes in flag names are
# translated to underscores, e.g. --web3.rpc → DAVINCI_DKG_WEB3_RPC,
# --poll-interval → DAVINCI_DKG_POLL_INTERVAL.
# ---------------------------------------------------------------------------

# ---- Chain connection -----------------------------------------------------
# JSON-RPC endpoint(s), comma-separated. Empty uses the public endpoints
# built in for the network (Gnosis Chain has three; Sepolia has none, so
# set your own there). Keep at least two: the node classifies rate-limited
# or unreachable endpoints and rotates off them, so a single-endpoint list
# has no fallback when a provider rate-limits you. The node checks that the
# endpoints serve the network's chain and refuses to start otherwise.
DAVINCI_DKG_WEB3_RPC=

# Hex private key used to sign node transactions (registration, claim,
# contribute, decrypt). Must start with 0x.
DAVINCI_DKG_PRIVKEY=

# ---- Network / contract addresses ----------------------------------------
# Leave both empty to run on Gnosis Chain, the default network. The
# DKGManager address is built into the binary; the registry, the app
# manager and the verifiers are read from it on chain. When a release moves
# the Gnosis preset to a new deployment, a node left on the default follows
# it after the next image update, with a fresh state directory.
#
# DAVINCI_DKG_NETWORK names a built-in network: gnosis (the default) or the
# older sepolia testnet (alias: sep), which needs DAVINCI_DKG_WEB3_RPC.
#
#   DAVINCI_DKG_NETWORK=sepolia
#
# DAVINCI_DKG_MANAGER runs any other deployment: set it together with
# DAVINCI_DKG_WEB3_RPC (default http://127.0.0.1:8545). It takes precedence
# over the network's manager and skips the chain id check.
DAVINCI_DKG_NETWORK=
DAVINCI_DKG_MANAGER=

# ---- Node runtime ---------------------------------------------------------
# Local state directory (default ~/.davinci-dkg). The node keeps each
# deployment's state in its own <datadir>/<chainid>-<manager> subdirectory
# and moves state an older release left directly in the datadir there once.
DAVINCI_DKG_DATADIR=

# How often the service polls the chain for round lifecycle events.
DAVINCI_DKG_POLL_INTERVAL=20s

# Shared directory for ciphertext files (testnet only).
DAVINCI_DKG_SHARED_DIR=/shared

# Circuit artifact cache directory. Defaults to ~/.davinci/artifacts when empty.
DAVINCI_DKG_ARTIFACTS_DIR=

# ---- Logging --------------------------------------------------------------
# Level: debug | info | warn | error
DAVINCI_DKG_LOG_LEVEL=info
DAVINCI_DKG_LOG_OUTPUT=stdout

# ---- Contract deployment (solidity/deploy_all.sh) ------------------------
# These are only read by the deployment script, not by the node.
# RPC_URL, CHAIN_ID and PRIVATE_KEY are required; ETHERSCAN_API_KEY is
# optional and unlocks post-deploy contract verification on Etherscan (or
# any Etherscan-compatible explorer, set VERIFIER_URL to point to it).
# RPC_URL=
# CHAIN_ID=
# PRIVATE_KEY=
# ETHERSCAN_API_KEY=
# VERIFIER_URL=

# ---- Docker Compose overrides (optional) ---------------------------------
# Pin the image tag used by the compose `node` service. Defaults to
# `latest`, which Watchtower follows and which only moves on stable
# releases. Set to an immutable version (e.g. v0.1.0) to disable
# auto-updates for this deployment.
# DAVINCI_DKG_TAG=latest

# ---- Standalone UI image (compose `ui` profile, optional) ----------------
# Pin the standalone UI image tag and override the host-side port the
# nginx container listens on. The UI talks to the chain directly; see the
# header of docker-compose.yml for the full list of UI env knobs
# (DAVINCI_DKG_RPC_URL, DAVINCI_DKG_MANAGER_ADDRESS, …) plus their short
# RPC_URL / MANAGER_ADDRESS / … aliases.
# DAVINCI_DKG_UI_TAG=latest
# DAVINCI_DKG_UI_PORT=8082
